---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Rejestracja zakończona",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź pocztę e-mail",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Otwórz go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <main class="flex min-h-screen items-center justify-center bg-background px-4 py-12">
    <div
      class="w-full max-w-sm rounded-2xl border border-border bg-card p-6 text-center text-card-foreground shadow-sm sm:p-8"
    >
      <div class="mb-4 text-5xl" aria-hidden="true">{content.emoji}</div>
      <h1 class="mb-3 text-2xl font-bold">
        {content.heading}
      </h1>
      <p class="mb-6 text-muted-foreground">{content.description}</p>
      <a
        href="/auth/signin"
        class="rounded-sm text-sm font-medium text-foreground underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        {content.linkText}
      </a>
    </div>
  </main>
</Layout>
