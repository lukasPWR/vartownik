---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm.vue";
---

<Layout title="Logowanie">
  <main class="flex min-h-screen items-center justify-center bg-background px-4 py-12">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8">
      <h1 class="mb-6 text-center text-2xl font-bold">Zaloguj się</h1>
      <SignInForm client:load />
      <p class="mt-6 text-center text-sm text-muted-foreground">
        Nie masz konta?
        <a
          href="/auth/signup"
          class="rounded-sm font-medium text-foreground underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >Zarejestruj się</a
        >
      </p>
    </div>
  </main>
</Layout>
