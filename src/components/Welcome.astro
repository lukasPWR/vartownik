---
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
const actionHref = user ? "/dashboard" : "/auth/signup";
const actionLabel = user ? "Przejdź do panelu" : "Załóż konto";
---

<div class="min-h-screen bg-background px-4 py-6 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <Topbar />

    <main
      class="grid min-h-[calc(100vh-8rem)] items-center gap-10 py-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:gap-16"
    >
      <div class="max-w-2xl">
        <p class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">VARtownik</p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight text-foreground sm:text-5xl lg:text-6xl">
          Trening wiedzy piłkarskiej
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Sprawdź swoją wiedzę w quizie o piłce nożnej i zobacz postępy po rozegranych sesjach.
        </p>
        <a href={actionHref} class={cn(buttonVariants({ size: "lg" }), "mt-8 w-full sm:w-auto")}>
          {actionLabel}
        </a>
      </div>

      <aside class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1" aria-label="Co znajdziesz w VARtowniku">
        <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
          <span
            class="mb-5 flex size-10 items-center justify-center rounded-lg bg-secondary text-secondary-foreground"
            aria-hidden="true">01</span
          >
          <h2 class="text-xl font-semibold text-card-foreground">Quiz piłkarski</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            Odpowiadaj na pytania i sprawdzaj, ile wiesz o futbolu.
          </p>
        </section>
        <section class="rounded-xl border border-border bg-card p-6 shadow-sm">
          <span
            class="mb-5 flex size-10 items-center justify-center rounded-lg bg-secondary text-secondary-foreground"
            aria-hidden="true">02</span
          >
          <h2 class="text-xl font-semibold text-card-foreground">Podgląd postępów</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            W panelu zobaczysz swoje statystyki i ostatnie sesje.
          </p>
        </section>
      </aside>
    </main>
  </div>
</div>
