---
import type { PendingQuestionDTO } from "@/types";
import { PENDING_REVIEW_STATUS } from "@/lib/question-status";

interface Props {
  flaggedQuestions: PendingQuestionDTO[];
  totalFlagged: number;
}

const { flaggedQuestions, totalFlagged } = Astro.props;

const MAX_SHOWN = 5;
const displayed = flaggedQuestions.slice(0, MAX_SHOWN);

function truncate(text: string, max: number): string {
  return text.length > max ? `${text.slice(0, max)}…` : text;
}
---

<section
  aria-labelledby="pending-reviews-heading"
  class="rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm"
>
  <div class="mb-4 flex items-center justify-between gap-2">
    <h2 id="pending-reviews-heading" class="text-lg font-semibold text-card-foreground">Do przejrzenia</h2>
    {
      totalFlagged > 0 && (
        <span
          class="inline-flex items-center rounded-full border border-warning/30 bg-warning/10 px-2.5 py-0.5 text-xs font-medium text-warning"
          aria-label={`${totalFlagged} pytań oczekuje na przegląd`}
        >
          {totalFlagged} oczekuje
        </span>
      )
    }
  </div>

  {
    flaggedQuestions.length === 0 ? (
      <p class="text-sm text-muted-foreground">Brak pytań do przejrzenia ✓</p>
    ) : (
      <>
        <ul class="mb-4 space-y-2" role="list">
          {displayed.map((q) => (
            <li class="flex items-center justify-between gap-3 rounded-lg bg-muted px-3 py-2 text-sm">
              <span class="truncate text-foreground" title={q.question_text}>
                {truncate(q.question_text, 80)}
              </span>
              <a
                href={`/questions/${q.id}/edit`}
                class="shrink-0 rounded-sm text-xs text-foreground underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
              >
                Edytuj
              </a>
            </li>
          ))}
        </ul>
        {totalFlagged > 0 && (
          <a
            href={`/questions?status=${PENDING_REVIEW_STATUS}`}
            class="rounded-sm text-xs text-foreground underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          >
            Zobacz wszystkie →
          </a>
        )}
      </>
    )
  }
</section>
