---
interface Props {
  value: string;
  label: string;
  accent?: string;
}

const { value, label, accent = "text-foreground" } = Astro.props;
---

<div
  class="flex flex-col gap-3 rounded-xl border border-border bg-card p-5 text-card-foreground shadow-sm"
  role="figure"
  aria-label={label}
>
  <div class="flex items-center gap-2 text-muted-foreground">
    <span class="size-5 shrink-0" aria-hidden="true">
      <slot name="icon" />
    </span>
    <p class="text-sm font-medium">{label}</p>
  </div>
  <p class={`text-3xl font-bold tracking-tight ${accent}`}>{value}</p>
</div>
